extends ../layout

block breadcrumb
  li.breadcrumb-item
    a(href="/employees") Employees
  li.breadcrumb-item.active Add New Employee

block content
  .card.shadow
    .card-body
      form.needs-validation(action="/employees" method="post" novalidate)
        .row
          .col-md-6.mb-3
            label.form-label.required(for="firstName") First Name
            input#firstName.form-control(type="text" name="firstName" required)
            .invalid-feedback Please provide a first name.
          
          .col-md-6.mb-3
            label.form-label.required(for="lastName") Last Name
            input#lastName.form-control(type="text" name="lastName" required)
            .invalid-feedback Please provide a last name.
        
        .row
          .col-md-6.mb-3
            label.form-label.required(for="email") Email
            input#email.form-control(type="email" name="email" required)
            .invalid-feedback Please provide a valid email address.
          
          .col-md-6.mb-3
            label.form-label.required(for="employeeId") Employee ID
            input#employeeId.form-control(type="text" name="employeeId" required)
            .invalid-feedback Please provide an employee ID.
        
        .row
          .col-md-6.mb-3
            label.form-label.required(for="department") Department
            input#department.form-control(type="text" name="department" required)
            .invalid-feedback Please provide a department.
          
          .col-md-6.mb-3
            label.form-label.required(for="position") Position
            input#position.form-control(type="text" name="position" required)
            .invalid-feedback Please provide a position.
        
        .row
          .col-md-6.mb-3
            label.form-label(for="phoneNumber") Phone Number
            input#phoneNumber.form-control(type="text" name="phoneNumber")
        
        .row
          .col-md-6.mb-3
            label.form-label(for="hireDate") Hire Date
            input#hireDate.form-control(type="date" name="hireDate" value=new Date().toISOString().slice(0, 10))
          
          .col-md-6.mb-3
            label.form-label(for="isActive") Status
            select#isActive.form-control.form-select(name="isActive")
              option(value="true" selected) Active
              option(value="false") Inactive
        
        .row
          .col-md-12.mb-3
            label.form-label(for="address") Address
            textarea#address.form-control(name="address" rows="2")
        
        .d-flex.justify-content-end.mt-4
          a.btn.btn-secondary.me-2(href="/employees") Cancel
          button.btn.btn-primary(type="submit") Save Employee

block scripts
  script.
    document.addEventListener('DOMContentLoaded', function() {
      // Auto-focus the first field
      document.getElementById('firstName').focus();
    });
