extends layout

block content
  .container
    .row.justify-content-center.mt-5
      .col-md-8
        .card.shadow
          .card-body.text-center
            i.fas.fa-exclamation-triangle.text-danger.fa-5x.mb-4
            h1.h4= message
            if error && error.status
              h2.text-muted= error.status
            if error && error.stack && process.env.NODE_ENV === 'development'
              pre.mt-4.text-start.bg-light.p-3.rounded
                code= error.stack
            .mt-4
              a.btn.btn-primary(href="/")
                i.fas.fa-home.me-2
                | Back to Dashboard